# Settings template (committed). Copy to .env (git-ignored) and edit there;
# the first build does the copy for you. Every key keeps the default below
# unless .env sets it. Turned into src/local_config.h at build time.

# WiFi: leave these empty and choose the network from the board's setup
# network (it opens on the first start: join "Printer-Setup-XXXX" on a phone).
# Set them only to build the network into the firmware; a network chosen on
# the setup page wins over them. 2.4 GHz only.
WIFI_SSID=
WIFI_PASSWORD=

# Password of the setup network (8 to 63 characters); empty: open. With a
# password the setup network also opens by itself when the saved network has
# been gone for 5 minutes; without one, hold BOOT 10 s to choose again.
SETUP_PASSWORD=

# Name shown in the AirPrint printer list on iPhone / Mac
PRINTER_NAME=Canon MG2500 (ESP32)

# Network host name: the web page is http://<HOSTNAME>.local/
HOSTNAME=canon-mg2500

# normal: print to the USB printer
# debug:  like normal, plus remote access for a board not connected to a
#         computer: log, crash dumps and firmware updates over WiFi
#         (tools/remote.py, pio run -t ota). Anyone on the network can update
#         the firmware, so only on a network you trust. Switching to normal
#         over WiFi removes the WiFi updates: the next one needs USB.
# dev:    no printer needed; AirPrint jobs are converted but not printed, and
#         the last job's printer data is served at http://<HOSTNAME>.local/dev/last-job.prn
MODE=normal
