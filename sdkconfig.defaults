CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_STATUS_LED_BRIGHTNESS=10
# 4 MB app slots (WiFi + mDNS + printing), room for OTA later
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# ESP32-S3-N16R8: 8 MB octal PSRAM. Allocations up to 16 KB (the per-line
# conversion buffers) stay in faster internal RAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
# boot without PSRAM rather than abort (e.g. under QEMU)
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
# bigger TCP windows: a page is several MB of raster
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=16384
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
CONFIG_LWIP_MAX_SOCKETS=12
CONFIG_MDNS_MAX_SERVICES=4
# QEMU's emulated Ethernet, used only by the qemu self test build
CONFIG_ETH_USE_OPENETH=y
# -O2: the raster conversion is CPU bound
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# larger caches: code and PSRAM data both go through them
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
# ESP32-S3-N16R8 flash supports quad I/O
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
